<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%- data.pageTitle %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="master-container">
      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12 text-center">
            <header>
              <h1 class="my-0 px-4 py-2 bg-dark text-light">
                <a href="./dashboard" class="link-light text-decoration-none">
                  <%- data.appTitle %>
                </a>
              </h1>
              <h2 class="my-0 px-4 py-2 bg-secondary text-light">
                <%- data.pageTitle %>
              </h2>
            </header>
          </div>
        </div>
      </div>

      <div class="container-fluid">
        <div class="row">
          <div class="col-12 col-md-8 offset-md-2 px-3 py-3">
            <p><strong><%- data.introduction %></strong></p>
            
            <ol class="mb-3">
              <li class="mb-3"><%- data.i1 %></li>
              <li class="mb-3"><%- data.i2 %></li>
              <li class="mb-3"><%- data.i3 %></li>
              <li class="mb-3"><%- data.i4 %></li>
            </ol>

            <p><strong><%- data.jesusDefines %></strong></p>

            <ol class="mb-3">
              <li class="mb-3">
                <div class="mb-3">
                  <strong><%- data.o1 %></strong>
                </div>
                <ol type="A">
                  <li class="mb-3"><%- data.o1a %></li>
                  <li class="mb-3"><%- data.o1b %></li>
                  <li class="mb-3"><%- data.o1c %></li>
                  <li class="mb-3"><%- data.o1d %></li>
                </ol>
              </li>

              <li class="mb-3">
                <div class="mb-3">
                  <strong><%- data.o2 %></strong>
                </div>
                <ol type="A">
                  <li class="mb-3"><%- data.o2a %></li>
                  <li class="mb-3"><%- data.o2b %></li>
                  <li class="mb-3"><%- data.o2c %></li>
                  <li class="mb-3"><%- data.o2d %></li>
                </ol>
              </li>

              <li class="mb-3">
                <div class="mb-3">
                  <strong><%- data.o3 %></strong>
                </div>
                <ol type="A">
                  <li class="mb-3"><%- data.o3a %></li>
                  <li class="mb-3"><%- data.o3b %></li>
                  <li class="mb-3"><%- data.o3c %></li>
                  <li class="mb-3"><%- data.o3d %></li>
                  <li class="mb-3"><%- data.o3e %></li>
                  <li class="mb-3"><%- data.o3f %></li>
                </ol>
              </li>

              <li class="mb-3">
                <div class="mb-3">
                  <strong><%- data.o4 %></strong>
                </div>
                <ol type="A">
                  <li class="mb-3"><%- data.o4a %></li>
                  <li class="mb-3"><%- data.o4b %></li>
                </ol>
              </li>

              <li class="mb-3">
                <div class="mb-3">
                  <strong><%- data.o5 %></strong>
                </div>
                <ol type="A">
                  <li class="mb-3"><%- data.o5a %></li>
                  <li class="mb-3"><%- data.o5b %></li>
                </ol>
              </li>

              <li class="mb-3">
                <div class="mb-3">
                  <strong><%- data.o6 %></strong>
                </div>
                <ol type="A">
                  <li class="mb-3"><%- data.o6a %></li>
                  <li class="mb-3"><%- data.o6b %></li>
                  <li class="mb-3"><%- data.o6c %></li>
                  <li class="mb-3"><%- data.o6d %></li>
                </ol>
              </li>
            </ol>

            <table class="table table-responsive my-4">
              <thead>
                <tr>
                  <th><%- data.tha %></th>
                  <th><%- data.thb %></th>
                  <th><%- data.thc %></th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><%- data.t1a %></td>
                  <td><%- data.t1b %></td>
                  <td><%- data.t1c %></td>
                </tr>
                <tr>
                  <td><%- data.t2a %></td>
                  <td><%- data.t2b %></td>
                  <td><%- data.t2c %></td>
                </tr>
                <tr>
                  <td><%- data.t3a %></td>
                  <td><%- data.t3b %></td>
                  <td><%- data.t3c %></td>
                </tr>
                <tr>
                  <td><%- data.t13a %></td>
                  <td><%- data.t13b %></td>
                  <td><%- data.t13c %></td>
                </tr>
                <tr>
                  <td><%- data.t33a %></td>
                  <td><%- data.t33b %></td>
                  <td><%- data.t33c %></td>
                </tr> 
              </tbody>
            </table>

            <p class="mt-4 pt-2"><%- data.conclusionQuestions %></p>
          </div>
        </div>
      </div>

      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12">
            <footer class="mt-2 px-4 py-4 bg-dark text-light text-center">
              &copy; 1980-<%= new Date().getFullYear() %> Kip McKean
            </footer>
          </div>
        </div>
      </div>
    </div>

    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker
            .register("/service-worker.js")
            .then((registration) => {
              console.log(
                "Service Worker registered with scope:",
                registration.scope
              );
            })
            .catch((err) => {
              console.log("Service Worker registration failed:", err);
            });
        });
      }
    </script>
  </body>
</html>
