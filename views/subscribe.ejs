<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= data.title %></title>
  </head>
  <body>
    <h1><%= data.title %></h1>
    <p><%= data.content %></p>

    <script>
      // 1. Register the Service Worker
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", async () => {
          try {
            const reg = await navigator.serviceWorker.register("/sw.js", {
              type: "module", // 👈 key difference
            });
            console.log("Service Worker registered with scope:", reg.scope);
          } catch (err) {
            console.error("Service Worker registration failed:", err);
          }
        });
      }

      // 2. Listen for clicks on <audio> play buttons
      document.addEventListener(
        "play",
        (event) => {
          const el = event.target;
          if (el.tagName.toLowerCase() === "audio") {
            const src = el.currentSrc || el.src;
            console.log("Audio play triggered for:", src);

            // Optionally send a message to the SW
            if (navigator.serviceWorker.controller && src) {
              navigator.serviceWorker.controller.postMessage({
                type: "AUDIO_PLAY",
                url: src,
              });
            }
          }
        },
        true
      ); // use capture so it fires reliably
    </script>
  </body>
</html>
