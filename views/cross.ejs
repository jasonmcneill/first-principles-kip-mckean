<!DOCTYPE html>
<html lang="<%- data.metadata.lang %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <meta name="view-transition" content="same-origin" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <title><%- data.pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link
      rel="shortcut icon"
      href="/img/<%- data.metadata.lang %>/launch/favicon.ico"
      type="image/x-icon"
    />
    <link
      rel="icon"
      href="/img/<%- data.metadata.lang %>/launch/favicon.ico"
      type="image/x-icon"
    />
    <link
      rel="apple-touch-icon"
      href="/img/<%- data.metadata.lang %>/launch/180.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/img/<%- data.metadata.lang %>/launch/180.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="167x167"
      href="/img/<%- data.metadata.lang %>/launch/167.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="152x152"
      href="/img/<%- data.metadata.lang %>/launch/152.png"
    />
    <link rel="manifest" href="/manifests/<%- data.metadata.lang %>.json" />
  </head>
  <body>
    <div class="master-container">
      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12 text-center">
            <div
              class="d-flex justify-content-between align-items-center bg-dark"
            >
              <a
                href="./dashboard"
                class="link-light text-decoration-none float-start px-3"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  fill="currentColor"
                  class="bi bi-house-fill"
                  viewBox="0 0 16 16"
                >
                  <path
                    d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L8 2.207l6.646 6.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z"
                  />
                  <path
                    d="m8 3.293 6 6V13.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5V9.293z"
                  />
                </svg>
              </a>
              <h1
                class="pageHeadline my-0 px-3 py-2 bg-dark text-light d-inline-block"
              >
                <%- data.appTitle %>
              </h1>
              <span class="invisible float-end px-3">
                <div
                  class="d-inline-block"
                  style="width: 24px; height: 24px"
                ></div>
              </span>
            </div>
            <div class="text-center ps-3 pe-2 py-2 bg-secondary text-light">
              <h2 class="pageHeadline my-0 balance"><%- data.pageTitle %></h2>
            </div>
          </div>
        </div>
      </div>

      <div class="container-fluid">
        <div class="row">
          <div class="col-12 col-md-8 offset-md-2 px-3 py-3">
            <% if(data.metadata.hasAudio) { %>
            <div class="audioContainer text-center my-3">
              <audio controls preload="none">
                <source
                  src="/audio/<%- data.metadata.lang %>/the-cross.webm"
                  controls
                  type="audio/webm; codecs=opus"
                />
              </audio>
            </div>
            <% } %>

            <ol>
              <li class="mb-3">
                <strong><%- data.o1p1 %></strong>
                <div class="my-3"><%- data.o1p2 %></div>
                <div class="my-3"><%- data.o1p3 %></div>
                <p class="mb-2"><%- data.o1i1 %></p>
                <p class="my-2"><%- data.o1i2 %></p>
                <p class="my-2"><%- data.o1i3 %></p>
                <p class="my-2"><%- data.o1i4 %></p>
                <p class="my-2"><%- data.o1i5 %></p>
                <p class="my-2"><%- data.o1i6 %></p>
                <p class="my-2"><%- data.o1i7 %></p>
                <p class="my-2"><%- data.o1i8 %></p>
                <p class="my-2"><%- data.o1i9 %></p>
                <p class="my-2"><%- data.o1i10 %></p>
                <p class="my-2"><%- data.o1i11 %></p>
                <p class="my-2"><%- data.o1i12 %></p>
                <p class="mt-2"><%- data.o1i13 %></p>
              </li>
              <li class="mb-3">
                <div class="mb-3">
                  <strong><%- data.o2p1 %></strong>
                </div>
                <div><%- data.o2p2 %></div>
              </li>
              <li class="mb-3">
                <div class="mb-3">
                  <strong><%- data.o3 %></strong>
                </div>
                <ol type="A">
                  <li class="mb-3"><%- data.o3a %></li>
                  <li class="mb-3"><%- data.o3b %></li>
                  <li class="mb-3"><%- data.o3c %></li>
                  <li class="mb-3"><%- data.o3d %></li>
                  <li class="mb-3"><%- data.o3e %></li>
                  <li class="mb-3"><%- data.o3f %></li>
                  <li class="mb-3"><%- data.o3g %></li>
                </ol>
              </li>
            </ol>

            <div
              class="modal fade"
              id="modal"
              data-bs-keyboard="false"
              tabindex="-1"
              aria-labelledby="modalHeader"
              aria-hidden="true"
            >
              <div
                class="modal-dialog modal-dialog-centered modal-dialog-scrollable"
              >
                <div class="modal-content">
                  <div class="modal-header">
                    <h1 class="modal-title fs-5" id="modalHeader">Test</h1>
                    <button
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="modal"
                      aria-label="Close"
                    ></button>
                  </div>
                  <div class="modal-body"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12">
            <footer class="mt-2 px-4 py-4 bg-dark text-light text-center">
              &copy; 1980-<%= new Date().getFullYear() %> Kip McKean
            </footer>
          </div>
        </div>
      </div>
    </div>

    <script src="/js/global.js"></script>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>

    <script src="/js/load-sw.js"></script>
  </body>
</html>
