<!DOCTYPE html>
<html lang="<%- data.metadata.lang %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <meta name="view-transition" content="same-origin" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <script src="/js/enforceAccess.js"></script>
    <title><%- data.pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link
      rel="shortcut icon"
      href="/img/<%- data.metadata.lang %>/launch/favicon.ico"
      type="image/x-icon"
    />
    <link
      rel="icon"
      href="/img/<%- data.metadata.lang %>/launch/favicon.ico"
      type="image/x-icon"
    />
    <link
      rel="apple-touch-icon"
      href="/img/<%- data.metadata.lang %>/launch/180.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/img/<%- data.metadata.lang %>/launch/180.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="167x167"
      href="/img/<%- data.metadata.lang %>/launch/167.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="152x152"
      href="/img/<%- data.metadata.lang %>/launch/152.png"
    />
    <link rel="manifest" href="/manifests/<%- data.metadata.lang %>.json" />
  </head>
  <body>
    <div class="master-container">
      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12 text-center">
            <div
              class="d-flex justify-content-between align-items-center bg-green"
            >
              <a
                href="./dashboard"
                class="link-light text-decoration-none float-start px-3"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  fill="currentColor"
                  class="bi bi-house-fill"
                  viewBox="0 0 16 16"
                >
                  <path
                    d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L8 2.207l6.646 6.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z"
                  />
                  <path
                    d="m8 3.293 6 6V13.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5V9.293z"
                  />
                </svg>
              </a>
              <h1
                class="pageHeadline my-0 px-3 py-2 bg-green text-light d-inline-block"
              >
                <%- data.appTitle %>
              </h1>
              <span class="float-end px-3">
                <button
                  class="navbar-toggler link-light"
                  type="button"
                  data-bs-toggle="offcanvas"
                  data-bs-target="#offcanvasWithBothOptions"
                  aria-controls="offcanvasWithBothOptions"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    fill="currentColor"
                    class="bi bi-list"
                    viewBox="0 0 16 16"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"
                    />
                  </svg>
                </button>
              </span>
            </div>
            <div class="text-center ps-3 pe-2 py-2 bg-light-green text-light">
              <h2 class="pageHeadline my-0 balance"><%- data.pageTitle %></h2>
            </div>
          </div>
        </div>
      </div>

      <div
        class="offcanvas offcanvas-end"
        data-bs-scroll="true"
        tabindex="-1"
        id="offcanvasWithBothOptions"
        aria-labelledby="offcanvasWithBothOptionsLabel"
      >
        <div class="offcanvas-header bg-green text-light pe-md-0">
          <h5
            class="offcanvas-title flex-grow-1"
            id="offcanvasWithBothOptionsLabel"
          >
            <%- data.sideMenuHeader %>
          </h5>
          <button
            class="btn text-light"
            type="button"
            data-bs-dismiss="offcanvas"
            aria-label="Close"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              fill="currentColor"
              class="bi bi-x-lg"
              viewBox="0 0 16 16"
            >
              <path
                d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"
              />
            </svg>
          </button>
        </div>
        <div class="offcanvas-body">
          <p></p>
        </div>
      </div>

      <div class="container-fluid">
        <div class="row bg-light">
          <div class="col-12 col-md-8 offset-md-2 px-3 py-3">
            <ol>
              <li class="mb-3"><%- data.o1 %></li>
              <li class="mb-3"><%- data.o2 %></li>
              <li class="mb-3"><%- data.o3 %></li>
              <li class="mb-3"><%- data.o4 %></li>
              <li class="mb-3"><%- data.o5 %></li>
              <li class="mb-3"><%- data.o6 %></li>
            </ol>

            <h3 class="mt-4"><%- data.outlineOfClasses %></h3>
            <table class="table table-responsive">
              <tbody>
                <tr>
                  <td class="bg-light"><%- data.session1 %></td>
                  <td class="bg-light"><%- data.session1IntroSG %></td>
                </tr>
                <tr>
                  <td class="bg-light"><%- data.session2 %></td>
                  <td class="bg-light"><%- data.session2Word %></td>
                </tr>
                <tr>
                  <td class="bg-light"><%- data.session3 %></td>
                  <td class="bg-light"><%- data.session3Discipleship %></td>
                </tr>
                <tr>
                  <td class="bg-light"><%- data.session4 %></td>
                  <td class="bg-light"><%- data.session4Kingdom %></td>
                </tr>
                <tr>
                  <td class="bg-light"><%- data.session5 %></td>
                  <td class="bg-light"><%- data.session5LAndD %></td>
                </tr>
                <tr>
                  <td class="bg-light"><%- data.session6 %></td>
                  <td class="bg-light"><%- data.session6NTConversion %></td>
                </tr>
                <tr>
                  <td class="bg-light"><%- data.session7 %></td>
                  <td class="bg-light"><%- data.session7Cross %></td>
                </tr>
                <tr>
                  <td class="bg-light"><%- data.session8 %></td>
                  <td class="bg-light"><%- data.session8BaptismHS %></td>
                </tr>
                <tr>
                  <td class="bg-light"><%- data.session9 %></td>
                  <td class="bg-light"><%- data.session9MGHS %></td>
                </tr>
                <tr>
                  <td class="bg-light"><%- data.session10 %></td>
                  <td class="bg-light"><%- data.session10Acts %></td>
                </tr>
                <tr>
                  <td class="bg-light text-nowrap"><%- data.sessions1114 %></td>
                  <td class="bg-light"><%- data.sessions1114Acts %></td>
                </tr>
              </tbody>
            </table>

            <h3 class="mt-4"><%- data.suggestedReadingList %></h3>
            <p><%- data.suggestedRLP1 %></p>

            <p>
              <span><%- data.authorChapman %></span>
              <strong
                ><a
                  href="https://www.amazon.com/Love-Languages-Secret-that-Lasts/dp/080241270X/"
                  ><%- data.book5LoveLangs %></a
                ></strong
              >
            </p>
            <p>
              <span><%- data.authorColeman %></span>
              <strong
                ><a
                  href="https://www.amazon.com/Master-Plan-Evangelism-Study-Guide/dp/0739466135/"
                  ><%- data.bookMasterPlanEvan %></a
                ></strong
              >
            </p>
            <p>
              <span><%- data.authorEdwards %></span>
              <strong
                ><a
                  href="https://www.amazon.com/Tale-three-Kings-Study-Brokenness/dp/0842369082/"
                  ><%- data.bookTale3Kings %></a
                ></strong
              >
            </p>
            <p>
              <span><%- data.authorMcKean %></span>
              <strong
                ><a
                  href="https://www.amazon.com/ELEVATE-Jesuss-Global-Revolution-Women/dp/958595740X/"
                  ><%- data.bookElevate %></a
                ></strong
              >
            </p>
            <p>
              <span><%- data.authorMoreno %></span>
              <strong
                ><a
                  href="https://www.amazon.com/Battle-That-Even-Kings-Lost/dp/1723023744/"
                  ><%- data.bookBattleKingsLost %></a
                ></strong
              >
            </p>
            <p>
              <span><%- data.authorSmellie %></span>
              <strong
                ><a
                  href="https://www.amazon.com/Proven-Genuine-Examination-Suffering-Book/dp/B08F6JZ4JV/"
                  ><%- data.bookProvenGenuine %></a
                ></strong
              >
            </p>
            <p>
              <span><%- data.authorTaylor %></span>
              <strong
                ><a
                  href="https://www.amazon.com/Disciplined-Life-Mark-Christian-Maturity/dp/0764225979/"
                  ><%- data.bookDisciplinedLife %></a
                ></strong
              >
            </p>

            <h3 class="mt-4"><%- data.scriptureMemory %></h3>

            <p><%- data.scriptureMemP1 %></p>

            <p class="mb-3">
              <span><%- data.memSess1 %></span>
              <strong class="d-block ms-3" data-scripture="jeremiah-29-11">
                <%- data.memSess1a %>
              </strong>
              <strong class="d-block ms-3" data-scripture="matthew-6-33">
                <%- data.memSess1b %>
              </strong>
            </p>

            <p class="mb-3">
              <span><%- data.memSess2 %></span>
              <strong class="d-block ms-3" data-scripture="john-8-31-32">
                <%- data.memSess2a %>
              </strong>
              <strong class="d-block ms-3" data-scripture="phillipians-4-13">
                <%- data.memSess2b %>
              </strong>
            </p>

            <p class="mb-3">
              <span><%- data.memSess3 %></span>
              <strong class="d-block ms-3" data-scripture="mark-1-17">
                <%- data.memSess3a %>
              </strong>
              <strong class="d-block ms-3" data-scripture="john-13-34-35">
                <%- data.memSess3b %>
              </strong>
            </p>

            <p class="mb-3">
              <span><%- data.memSess4 %></span>
              <strong class="d-block ms-3" data-scripture="acts-2-38">
                <%- data.memSess4a %>
              </strong>
              <strong class="d-block ms-3" data-scripture="phillipians-4-4">
                <%- data.memSess4b %>
              </strong>
            </p>

            <p class="mb-3">
              <span><%- data.memSess5 %></span>
              <strong class="d-block ms-3" data-scripture="ezekiel-18-20">
                <%- data.memSess5a %>
              </strong>
              <strong class="d-block ms-3" data-scripture="galatians-1-8">
                <%- data.memSess5b %>
              </strong>
            </p>

            <p class="mb-3">
              <span><%- data.memSess6 %></span>
              <strong class="d-block ms-3" data-scripture="matthew-22-37-39">
                <%- data.memSess6a %>
              </strong>
              <strong class="d-block ms-3" data-scripture="john-15-8">
                <%- data.memSess6b %>
              </strong>
            </p>

            <p class="mb-3">
              <span><%- data.memSess7 %></span>
              <strong class="d-block ms-3" data-scripture="matthew-28-18-20">
                <%- data.memSess7a %>
              </strong>
              <strong class="d-block ms-3" data-scripture="luke-19-10">
                <%- data.memSess7b %>
              </strong>
            </p>

            <p class="mb-3">
              <span><%- data.memSess8 %></span>
              <strong class="d-block ms-3" data-scripture="hebrews-10-23-25">
                <%- data.memSess8a %>
              </strong>
              <strong class="d-block ms-3" data-scripture="1-john-1-9">
                <%- data.memSess8b %>
              </strong>
            </p>

            <p class="mb-3">
              <span><%- data.memSess9 %></span>
              <strong class="d-block ms-3" data-scripture="hebrews-12-15">
                <%- data.memSess9a %>
              </strong>
              <strong class="d-block ms-3" data-scripture="hebrews-13-17">
                <%- data.memSess9b %>
              </strong>
            </p>

            <div
              class="modal fade"
              id="modal"
              data-bs-keyboard="false"
              tabindex="-1"
              aria-labelledby="modalHeader"
              aria-hidden="true"
            >
              <div
                class="modal-dialog modal-dialog-centered modal-dialog-scrollable"
              >
                <div class="modal-content">
                  <div class="modal-header">
                    <h1 class="modal-title fs-5" id="modalHeader"></h1>
                    <button
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="modal"
                      aria-label="Close"
                    ></button>
                  </div>
                  <div class="modal-body"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12">
            <footer class="mt-2 px-4 py-4 bg-dark text-light text-center">
              &copy; 1980-<%= new Date().getFullYear() %> Kip McKean
            </footer>
          </div>
        </div>
      </div>
    </div>

    <script src="/js/global.js"></script>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>

    <script src="/js/load-sw.js"></script>
  </body>
</html>
