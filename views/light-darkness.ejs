<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <meta name="view-transition" content="same-origin" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title><%- data.pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="master-container">
      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12 text-center bg-dark">
            <div class="d-flex justify-content-between align-items-center">
              <a
                href="./dashboard"
                class="link-light text-decoration-none float-start px-3"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  fill="currentColor"
                  class="bi bi-house-fill"
                  viewBox="0 0 16 16"
                >
                  <path
                    d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L8 2.207l6.646 6.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z"
                  />
                  <path
                    d="m8 3.293 6 6V13.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5V9.293z"
                  />
                </svg>
              </a>
              <h1 class="my-0 px-3 py-2 bg-dark text-light d-inline-block">
                <%- data.appTitle %>
              </h1>
              <span class="invisible float-end px-3">
                <div
                  class="d-inline-block"
                  style="width: 24px; height: 24px"
                ></div>
              </span>
            </div>
            <div class="text-center px-2 py-2 bg-secondary text-light">
              <h2 class="my-0 balance"><%- data.pageTitle %></h2>
            </div>
          </div>
        </div>
      </div>

      <div class="container-fluid">
        <div class="row">
          <div class="col-12 col-md-8 offset-md-2 px-3 py-3">
            <div class="audioContainer text-center my-3">
              <audio controls preload="none">
                <source
                  src="/audio/<%- data.metadata.lang %>/light-darkness.webm"
                  controls
                  type="audio/webm; codecs=opus"
                />
              </audio>
            </div>

            <p>
              <strong> <%- data.introduction %> </strong>
            </p>

            <div class="my-4 text-center">
              <img
                class="img-fluid"
                src="/img/<%- data.metadata.lang %>/darkness-vs-light.svg"
              />
            </div>

            <ol class="mb-5">
              <li class="mb-3"><%- data.introO1 %></li>
              <li class="mb-3"><%- data.introO2 %></li>
            </ol>

            <ol>
              <li class="mb-3">
                <div class="mb-3"><strong><%- data.o1 %></strong></div>
                <ol type="A">
                  <li class="mb-3">
                    <div class="mb-3"><strong><%- data.o1a %></strong></div>
                    <ol class="mb-3">
                      <li class="mb-3">
                        <%- data.o1a1 %>

                        <div class="my-3">
                          <img
                            class="img-fluid"
                            src="/img/<%- data.metadata.lang %>/wall.svg"
                          />
                        </div>
                      </li>
                      <li class="mb-3"><%- data.o1a2 %></li>
                      <li class="mb-3"><%- data.o1a3 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><strong><%- data.o1b %></strong></div>
                    <ol>
                      <li class="mb-3">
                        <%- data.o1b1 %>

                        <div class="my-3">
                          <img
                            class="img-fluid"
                            src="/img/<%- data.metadata.lang %>/sin.svg"
                          />
                        </div>
                      </li>
                      <li class="mb-3"><%- data.o1b2 %></li>
                      <li class="mb-3"><%- data.o1b3 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o1c %></div>
                    <ol>
                      <li class="mb-3"><%- data.o1c1 %></li>
                      <li class="mb-3"><%- data.o1c2 %></li>
                      <li class="mb-3"><%- data.o1c3 %></li>
                      <li class="mb-3">
                        <div class="mb-3"><%- data.o1c4 %></div>

                        <div class="mb-3">
                          <img
                            class="img-fluid"
                            src="/img/<%- data.metadata.lang %>/wages-vs-gift.svg"
                          />
                        </div>
                      </li>
                    </ol>
                  </li>
                </ol>
              </li>
              <li class="mb-3">
                <div class="mb-3"><strong><%- data.o2 %></strong></div>
                <ol type="A">
                  <li class="mb-3"><%- data.o2a %></li>
                  <li class="mb-3"><%- data.o2b %></li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o2c %></div>
                    <ol>
                      <li class="mb-3"><%- data.o2c1 %></li>
                      <li class="mb-3"><%- data.o2c2 %></li>
                      <li class="mb-3"><%- data.o2c3 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o2d %></div>
                    <ol>
                      <li class="mb-3"><%- data.o2d1 %></li>
                      <li class="mb-3"><%- data.o2d2 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o2e %></div>
                    <ol>
                      <li class="mb-3"><%- data.o2e1 %></li>
                      <li class="mb-3">
                        <div class="mb-3"><%- data.o2e2 %></div>
                        <ol type="a">
                          <li class="mb-3"><%- data.o2e2a %></li>
                          <li class="mb-3"><%- data.o2e2b %></li>
                        </ol>
                      </li>
                      <li class="mb-3">
                        <div class="mb-3"><%- data.o2e3l1 %></div>
                        <div class="mb-3"><%- data.o2e3l2 %></div>
                      </li>
                    </ol>
                  </li>
                </ol>
              </li>
            </ol>

            <div class="my-4 pt-3 text-center">
              <img
                class="img-fluid"
                src="/img/<%- data.metadata.lang %>/died-resurrected.svg"
              />
            </div>

            <br />

            <div class="d-flex justify-content-center">
              <table class="mb-5 table table-border">
                <thead>
                  <tr>
                    <th width="50%" class="text-center ps-0">
                      <%- data.o2e3h1 %>
                    </th>
                    <th width="50%" class="text-center pe-0">
                      <%- data.o2e3h2 %>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="ps-0">
                      <div class="text-center">
                        <strong><%- data.o2e3isaiah5912 %></strong>
                      </div>
                      <div class="text-sm-center">
                        <%- data.o2e3isaiah5912desc1 %>
                      </div>
                    </td>
                    <td class="pe-0">
                      <div class="text-center">
                        <strong><%- data.o2e3acts238 %></strong>
                      </div>
                      <div class="text-sm-center">
                        <%- data.o2e3acts238desc1 %>
                      </div>
                    </td>
                  </tr>
                  <tr>
                    <td class="ps-0">
                      <div class="text-center">
                        <strong><%- data.o2e3john35 %></strong>
                      </div>
                      <div class="text-sm-center">
                        <%- data.o2e3john35desc %>
                      </div>
                    </td>
                    <td class="pe-0">
                      <div class="text-center">
                        <strong><%- data.o2e3acts238 %></strong>
                      </div>
                      <div class="text-sm-center">
                        <%- data.o2e3acts238desc2 %>
                        <div class="mt-1"><%- data.o2e3acts238desc3 %></div>
                      </div>
                    </td>
                  </tr>
                  <tr>
                    <td class="ps-0">
                      <div class="text-center">
                        <strong><%- data.o2e3rom325 %></strong>
                      </div>
                      <div class="text-sm-center">
                        <%- data.o2e3rom325desc %>
                      </div>
                    </td>
                    <td>
                      <div class="pe-0">
                        <div class="text-center">
                          <strong><%- data.o2e3rom634 %></strong>
                        </div>
                        <div><%- data.o2e3rom634desc %></div>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <ol start="3">
              <li class="mb-3">
                <div class="mb-3">
                  <strong><%- data.o3 %></strong>
                </div>
                <ol type="A">
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o3a %></div>
                    <ol>
                      <li class="mb-3"><%- data.o3a1 %></li>
                      <li class="mb-3"><%- data.o3a2 %></li>
                      <li class="mb-3">
                        <div class="mb-3"><%- data.o3a3 %></div>
                        <ol type="a">
                          <li class="mb-3"><%- data.o3a3a %></li>
                          <li class="mb-3"><%- data.o3a3b %></li>
                        </ol>
                      </li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o3b %></div>
                    <ol>
                      <li class="mb-3"><%- data.o3b1 %></li>
                      <li class="mb-4"><%- data.o3b2 %></li>
                    </ol>
                  </li>
                </ol>
              </li>
              <li>
                <div class="mb-3">
                  <strong><%- data.o4 %></strong>
                </div>
                <div><%- data.o4p1 %></div>
              </li>
            </ol>

            <div
              class="modal fade"
              id="modal"
              data-bs-keyboard="false"
              tabindex="-1"
              aria-labelledby="modalHeader"
              aria-hidden="true"
            >
              <div
                class="modal-dialog modal-dialog-centered modal-dialog-scrollable"
              >
                <div class="modal-content">
                  <div class="modal-header">
                    <h1 class="modal-title fs-5" id="modalHeader">Test</h1>
                    <button
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="modal"
                      aria-label="Close"
                    ></button>
                  </div>
                  <div class="modal-body"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12">
            <footer class="mt-2 px-4 py-4 bg-dark text-light text-center">
              &copy; 1980-<%= new Date().getFullYear() %> Kip McKean
            </footer>
          </div>
        </div>
      </div>
    </div>

    <script src="/js/global.js"></script>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>

    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker
            .register("/sw.js")
            .catch((err) => console.error("SW registration failed:", err));
        });
      }

      // Cache audio recording if user clicks play
      document.addEventListener(
        "play",
        (event) => {
          const el = event.target;
          if (el.tagName.toLowerCase() === "audio") {
            const url = el.currentSrc || el.src;
            if ("caches" in window && url) {
              caches.open("audio-files").then((cache) => {
                cache.add(url).catch(() => {});
              });
            }
          }
        },
        true
      );
    </script>
  </body>
</html>
