<!DOCTYPE html>
<html lang="<%- data.metadata.lang %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <meta name="view-transition" content="same-origin" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <script src="/js/enforceAccess.js"></script>
    <title><%- data.pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link
      rel="shortcut icon"
      href="/img/<%- data.metadata.lang %>/launch/favicon.ico"
      type="image/x-icon"
    />
    <link
      rel="icon"
      href="/img/<%- data.metadata.lang %>/launch/favicon.ico"
      type="image/x-icon"
    />
    <link
      rel="apple-touch-icon"
      href="/img/<%- data.metadata.lang %>/launch/180.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/img/<%- data.metadata.lang %>/launch/180.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="167x167"
      href="/img/<%- data.metadata.lang %>/launch/167.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="152x152"
      href="/img/<%- data.metadata.lang %>/launch/152.png"
    />
    <style type="text/css">
      form label {
        font-weight: bold;
      }

      table.table {
        border-color: none;
      }
      table.table th,
      table.table td {
        background-color: unset;
      }

      table tr td:first-child {
        text-align: end;
        text-wrap-mode: nowrap;
        white-space: nowrap;
        width: 1%;
      }
    </style>
  </head>

  <body>
    <div class="master-container">
      <div class="container-fluid p-0">
        <div class="row">
          <div class="col-12 text-center">
            <div
              class="d-flex justify-content-between align-items-center bg-green"
            >
              <a
                href="./dashboard"
                class="link-light text-decoration-none float-start px-3"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  fill="currentColor"
                  class="bi bi-house-fill"
                  viewBox="0 0 16 16"
                >
                  <path
                    d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L8 2.207l6.646 6.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z"
                  />
                  <path
                    d="m8 3.293 6 6V13.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5V9.293z"
                  />
                </svg>
              </a>
              <h1
                class="pageHeadline my-0 px-3 py-2 bg-green text-light d-inline-block"
              >
                <%- data.appTitle %>
              </h1>
              <span class="float-end px-3">
                <button
                  class="navbar-toggler link-light"
                  type="button"
                  data-bs-toggle="offcanvas"
                  data-bs-target="#offcanvasWithBothOptions"
                  aria-controls="offcanvasWithBothOptions"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    fill="currentColor"
                    class="bi bi-list"
                    viewBox="0 0 16 16"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"
                    />
                  </svg>
                </button>
              </span>
            </div>
            <div class="text-center px-2 py-2 bg-light-green text-light">
              <h2 class="pageHeadline my-0 balance"><%- data.pageTitle %></h2>
            </div>
          </div>
        </div>
      </div>

      <div
        class="offcanvas offcanvas-end"
        data-bs-scroll="true"
        tabindex="-1"
        id="offcanvasWithBothOptions"
        aria-labelledby="offcanvasWithBothOptionsLabel"
      >
        <div class="offcanvas-header bg-green text-light py-1">
          <h5
            class="offcanvas-title flex-grow-1"
            id="offcanvasWithBothOptionsLabel"
          >
            <%- globalData.sideMenuHeader %>
          </h5>
          <button
            class="btn text-light"
            type="button"
            data-bs-dismiss="offcanvas"
            aria-label="Close"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              fill="currentColor"
              class="bi bi-x-lg"
              viewBox="0 0 16 16"
            >
              <path
                d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"
              />
            </svg>
          </button>
        </div>
        <div class="offcanvas-body bg-light">
          <div class="list-group bg-white shadow mb-4">
            <a
              href="./dashboard"
              class="list-group-item list-group-item-action"
            >
              <%- globalData.home %>
            </a>
            <a href="./account" class="list-group-item list-group-item-action">
              <%- globalData.account %>
            </a>
            <a
              href="javascript:logOut()"
              class="list-group-item list-group-item-action"
            >
              <%- globalData.logout %>
            </a>
          </div>
        </div>
      </div>

      <div class="container-fluid">
        <div class="row bg-light">
          <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
            <div id="pageSpinner">
              <div
                class="d-flex justify-content-center align-items-center"
                style="height: 200px"
              >
                <div class="spinner-border text-secondary" role="status">
                  <span class="visually-hidden"><%- globalData.loading %></span>
                </div>
              </div>
            </div>
            <main class="py-4 d-none">
              <div class="d-none" id="offline">
                <div class="alert alert-danger border-danger" role="alert">
                  <p>
                    <strong class="alert-heading">
                      <%- data.offlineHeadline %>
                    </strong>
                  </p>
                  <p><%- data.offline %></p>
                </div>
              </div>
              <section id="subscriptionSection">
                <div
                  class="d-none mb-5 text-center"
                  id="subscriptionActiveContainer"
                >
                  <p>
                    <strong><%- data.subscriptionStatus %></strong><br />
                    <strong class="text-uppercase text-success">
                      <%- data.active %>
                    </strong>
                  </p>

                  <div class="my-4">
                    <strong><%- data.nextAnnualPayment %></strong>
                    <table class="table">
                      <tbody>
                        <tr>
                          <td><%- data.amount %></td>
                          <td>
                            <span id="nextPmtAmt"> </span>
                          </td>
                        </tr>
                        <tr>
                          <td><%- data.date %></td>
                          <td>
                            <span id="nextPmtDate"> </span>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>

                  <div>
                    <button
                      type="button"
                      class="btn btn-sm btn-outline btn-outline-danger mt-2"
                      id="btnCancelSubscription"
                    >
                      <%- data.cancelSubscription %>
                    </button>
                  </div>
                </div>

                <div
                  class="d-none mb-5 text-center"
                  id="subscriptionSuspendedContainer"
                >
                  <p class="mb-4">
                    <strong><%- data.subscriptionStatus %></strong><br />
                    <strong class="text-uppercase text-danger">
                      <%- data.cancelled %>
                    </strong>
                    <br />
                    <small class="text-muted" id="dateSuspended">
                      <%- data.cancelledOn %>
                    </small>
                  </p>

                  <p class="my-4" id="accessRemainsUntilContainer"></p>

                  <p><%- data.suspendedNotChargedAgain %></p>

                  <button
                    class="btn btn-sm btn-primary"
                    id="btnReinstateSuspended"
                  >
                    <%- data.reinstateSubscription %>
                  </button>
                </div>

                <div
                  class="d-none mb-5 text-center"
                  id="subscriptionCancelledContainer"
                >
                  <p class="my-4">
                    <strong><%- data.subscriptionStatus %></strong><br />
                    <strong class="text-uppercase text-danger">
                      <%- data.cancelled %>
                    </strong>
                    <br />
                    <small class="text-muted" id="dateCancelled">
                      <%- data.cancelledOn %>
                    </small>
                  </p>

                  <p class="text-md-start text-center">
                    <a href="./subscribe" class="btn btn-sm btn-primary">
                      <%- data.resubscribe %>
                    </a>
                  </p>
                </div>
              </section>

              <section id="profileSection">
                <h2 class="border-bottom border-dark mb-3">
                  <%- data.headingProfile %>
                </h2>

                <form id="profileForm" class="d-none" novalidate>
                  <div class="bg-light my-4">
                    <input
                      type="hidden"
                      name="lang"
                      id="lang"
                      value="<%- data.metadata.lang %>"
                    />
                    <!-- Username -->
                    <div class="mb-4">
                      <label for="username" class="form-label"
                        ><%- data.username %></label
                      >
                      <input
                        type="text"
                        maxlength="255"
                        class="form-control"
                        id="username"
                        name="username"
                        required
                        autocomplete="off"
                        autocapitalize="off"
                      />
                      <div class="username invalid-feedback">
                        <%- data.errorUsernameRequired %>
                      </div>
                    </div>

                    <!-- Password -->
                    <div class="mb-4">
                      <label for="password" class="form-label"
                        ><%- data.password %></label
                      >
                      <input
                        type="password"
                        maxlength="255"
                        class="form-control"
                        id="password"
                        name="password"
                        required
                        autocomplete="new-password"
                        autocapitalize="off"
                      />
                      <div class="form-text">
                        <%- data.passwordRequirement %>
                      </div>
                      <div class="password invalid-feedback">
                        <%- data.errorPasswordRequired %>
                      </div>
                    </div>

                    <!-- Email -->
                    <div class="mb-4">
                      <label for="email" class="form-label"
                        ><%- data.email %></label
                      >
                      <input
                        type="email"
                        maxlength="255"
                        class="form-control"
                        id="email"
                        name="email"
                        autocomplete="email"
                        required
                      />
                      <div class="email invalid-feedback">
                        <%- data.errorEmailRequired %>
                      </div>
                    </div>

                    <!-- First Name -->
                    <div class="mb-4">
                      <label for="firstname" class="form-label">
                        <%- data.firstName %>
                      </label>
                      <input
                        type="text"
                        maxlength="255"
                        class="form-control"
                        id="firstname"
                        name="firstname"
                        required
                      />
                      <div class="firstname invalid-feedback">
                        <%- data.errorFirstNameRequired %>
                      </div>
                    </div>

                    <!-- Last Name -->
                    <div class="mb-4">
                      <label for="lastname" class="form-label">
                        <%- data.lastName %>
                      </label>
                      <input
                        type="text"
                        maxlength="255"
                        class="form-control"
                        id="lastname"
                        name="lastname"
                        required
                      />
                      <div class="lastname invalid-feedback">
                        <%- data.errorLastNameRequired %>
                      </div>
                    </div>

                    <!-- Gender -->
                    <div class="mb-4">
                      <div class="d-block mb-1">
                        <strong><%- data.gender %></strong>
                      </div>
                      <div class="form-check form-check-inline">
                        <input
                          class="form-check-input"
                          type="radio"
                          name="gender"
                          id="gender_male"
                          value="male"
                          required
                        />
                        <label class="form-check-label" for="gender_male">
                          <%- data.male %>
                        </label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input
                          class="form-check-input"
                          type="radio"
                          name="gender"
                          id="gender_female"
                          value="female"
                          required
                        />
                        <label class="form-check-label" for="gender_female">
                          <%- data.female %>
                        </label>
                      </div>
                      <div
                        class="text-danger d-none"
                        id="gender_invalid_feedback"
                      >
                        <%- data.errorGenderRequired %>
                      </div>
                    </div>

                    <!-- Mailing List -->
                    <div
                      class="my-5 border border-dark pt-3 pb-2 px-3"
                      style="background-color: var(--bs-gray-200)"
                    >
                      <div class="form-check form-check-inline">
                        <label for="mailinglist" class="form-label d-block">
                          <input
                            class="form-check-input"
                            type="checkbox"
                            name="mailinglist"
                            id="mailinglist"
                            value="1"
                            checked
                          />
                          <%- data.mailingList %>
                        </label>
                      </div>
                    </div>
                  </div>

                  <!-- Submit -->
                  <div class="text-center">
                    <button type="submit" class="btn btn-primary">
                      <span
                        class="spinner-border spinner-border-sm me-2 submitButtonSpinner d-none"
                        aria-hidden="true"
                      ></span>
                      <%- data.updateButton %>
                    </button>
                  </div>
                </form>
              </section>
            </main>
          </div>
        </div>
      </div>

      <div class="container-fluid p-0 fixed-bottom">
        <div class="row">
          <div class="col-12">
            <footer class="mt-2 px-4 py-4 bg-dark text-light text-center">
              &copy; 1980-<%= new Date().getFullYear() %> Kip McKean
            </footer>
          </div>
        </div>
      </div>
    </div>

    <div
      class="modal fade"
      id="modal"
      data-bs-keyboard="false"
      tabindex="-1"
      aria-labelledby="modalHeader"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="modalHeader"></h1>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body pb-4"></div>
          <div class="modal-footer d-none">
            <button
              class="btn btn-outline-dark modalCancel"
              data-bs-toggle="modal"
            ></button>
          </div>
        </div>
      </div>
    </div>

    <div
      class="modal fade"
      id="modalCancelSubscription"
      data-bs-keyboard="false"
      tabindex="-1"
      aria-labelledby="modalHeader"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5"><%- data.confirmCancelTitle %></h1>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body pb-4">
            <p></p>

            <p>
              <strong class="text-danger"><%- data.confirmCancelP2 %></strong>
            </p>
          </div>
          <div class="modal-footer">
            <button class="btn btn-danger subscriptionCancel">
              <%- data.confirmCancelBtn %>
            </button>
            <button
              class="btn btn-outline-dark modalCancel"
              data-bs-toggle="modal"
            >
              <%- data.confirmCancelClose %>
            </button>
          </div>
        </div>
      </div>
    </div>

    <script type="application/json" id="content">
      <%- JSON.stringify(data) %>
    </script>
    <script type="application/json" id="globalContent">
      <%- JSON.stringify(globalData) %>
    </script>
    <script src="/js/global.js"></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://www.paypal.com/sdk/js?client-id=<%- process.env.PAYPAL_CLIENT_ID %>&vault=true&intent=subscription&locale=<%- data.metadata.paypalLocale %>"
      data-sdk-integration-source="button-factory"
    ></script>
    <script src="/js/account.js"></script>
    <script src="/js/load-sw.js"></script>
  </body>
</html>
