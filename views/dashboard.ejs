<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <meta name="view-transition" content="same-origin" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title><%- data.appTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="master-container">
      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12 px-0">
            <header>
              <h1 class="my-0 px-2 py-2 bg-dark text-light text-center">
                <%- data.appTitle %>
              </h1>
            </header>
          </div>
        </div>
      </div>

      <div class="container-fluid">
        <div class="row bg-light">
          <div class="col-12 col-md-4 offset-md-4">
            <main>
              <div class="list-group my-4 bg-white shadow">
                <a
                  href="./introduction"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.introduction %>
                </a>
                <a
                  href="./course-information"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.courseInformation %>
                </a>
                <a
                  href="./intro-to-course"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.introToCourse %>
                </a>
                <!-- <a
                  href="./book-of-john"
                  class="list-group-item list-group-item-action d-none"
                >
                  <%- data.bookOfJohn %>
                </a> -->
                <a
                  href="./seeking-god"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.seekingGod %>
                </a>
                <a href="./word" class="list-group-item list-group-item-action">
                  <%- data.wordOfGod %>
                </a>
                <a
                  href="./discipleship"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.discipleship %>
                </a>
                <a
                  href="./kingdom"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.kingdom %>
                </a>
                <a
                  href="./light-darkness"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.lightDarkness %>
                </a>
                <a
                  href="./new-testament-conversion"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.newTestamentConversion %>
                </a>
                <a
                  href="./cross"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.cross %>
                </a>
                <a
                  href="./medical-account"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.medicalAccount %>
                </a>
                <a
                  href="./baptism-holy-spirit"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.baptismHolySpirit %>
                </a>
                <a
                  href="./miraculous-gifts-holy-spirit"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.miraculousGifts %>
                </a>
                <a
                  href="./church"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.church %>
                </a>
                <!-- <a
                  href="./book-of-acts"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.bookOfActs %>
                </a> -->
                <a
                  href="./after-baptism-now-what"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.afterBaptism %>
                </a>
                <a
                  href="./christ-is-your-life"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.christIsYourLife %>
                </a>
                <a
                  href="./best-friends-all-time"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.bestFriendsAllTime %>
                </a>
                <a
                  href="./the-mission"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.mission %>
                </a>
                <a
                  href="./persecution"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.persecution %>
                </a>
                <a
                  href="./memory-scriptures"
                  class="list-group-item list-group-item-action"
                >
                  <%- data.memoryScriptures %>
                </a>
              </div>
            </main>
          </div>
        </div>

        <div class="row">
          <div class="col-12">
            <footer class="mt-2 px-4 py-4 bg-dark text-light text-center">
              &copy; 1980-<%= new Date().getFullYear() %> Kip McKean
            </footer>
          </div>
        </div>
      </div>
    </div>

    <div
      class="modal fade"
      id="modal"
      data-bs-keyboard="false"
      tabindex="-1"
      aria-labelledby="modalHeader"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="modalHeader">Test</h1>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body"></div>
        </div>
      </div>
    </div>

    <script src="/js/global.js"></script>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>

    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", async () => {
          try {
            const reg = await navigator.serviceWorker.register("/sw.js", {
              type: "module", // 👈 key for ES module SW
            });
            console.log("Service Worker registered with scope:", reg.scope);
          } catch (err) {
            console.error("Service Worker registration failed:", err);
          }
        });
      }

      // Listen for audio plays
      document.addEventListener(
        "play",
        (event) => {
          const el = event.target;
          if (el.tagName.toLowerCase() === "audio") {
            console.log("Audio playing:", el.currentSrc || el.src);
          }
        },
        true
      );
    </script>
  </body>
</html>
