<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%- data.pageTitle %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="master-container">
      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12">
            <header>
              <h1 class="my-0 px-4 py-2 bg-dark text-light text-center">
                <%- data.appTitle %>
              </h1>
            </header>
          </div>
        </div>
      </div>

      <div class="container-fluid">
        <div class="row bg-light">
          <div class="col-12 col-md-4 offset-md-4">
            <main>
              <div class="list-group my-4 bg-white shadow">
                <a
                  href="./introduction"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.introduction %>
                </a>
                <a
                  href="./course-information"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.courseInformation %>
                </a>
                <a
                  href="./intro-to-course"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.introToCourse %>
                </a>
                <a
                  href="./book-of-john"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.bookOfJohn %>
                </a>
                <a
                  href="./seeking-god"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.seekingGod %>
                </a>
                <a
                  href="./word"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.wordOfGod %>
                </a>
                <a
                  href="./discipleship"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.discipleship %>
                </a>
                <a
                  href="./kingdom"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.kingdom %>
                </a>
                <a
                  href="./light-darkness"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.lightDarkness %>
                </a>
                <a
                  href="./new-testament-conversion"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.newTestamentConversion %>
                </a>
                <a
                  href="./cross"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.cross %>
                </a>
                <a
                  href="./medical-account"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.medicalAccount %>
                </a>
                <a
                  href="./baptism-holy-spirit"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.baptismHolySpirit %>
                </a>
                <a
                  href="./miraculous-gifts-holy-spirit"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.miraculousGifts %>
                </a>
                <a
                  href="./church"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.church %>
                </a>
                <a
                  href="./book-of-acts"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.bookOfActs %>
                </a>
                <a
                  href="./after-baptism-now-what"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.afterBaptism %>
                </a>
                <a
                  href="./christ-is-your-life"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.christIsYourLife %>
                </a>
                <a
                  href="./best-friends-all-time"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.bestFriendsAllTime %>
                </a>
                <a
                  href="./the-mission"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.mission %>
                </a>
                <a
                  href="./persecution"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.persecution %>
                </a>
                <a
                  href="./memory-scriptures"
                  class="list-group-item list-group-item-action"
                  aria-current="true"
                >
                  <%- data.memoryScriptures %>
                </a>
              </div>
            </main>
          </div>
        </div>

        <div class="row">
          <div class="col-12">
            <footer class="mt-2 px-4 py-4 bg-dark text-light text-center">
              &copy; 1980-<%= new Date().getFullYear() %> Kip McKean
            </footer>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
