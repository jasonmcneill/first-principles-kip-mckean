<!DOCTYPE html>
<html lang="<%- data.metadata.lang %>">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="google" content="notranslate" />
  <meta name="view-transition" content="same-origin" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <script src="/js/enforceSubscription.js"></script>
  <script src="/js/enforceAccess.js"></script>
  <title><%- data.pageTitle %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
  <link rel="shortcut icon" href="/img/<%- data.metadata.lang %>/launch/favicon.ico" type="image/x-icon" />
  <link rel="icon" href="/img/<%- data.metadata.lang %>/launch/favicon.ico" type="image/x-icon" />
  <link rel="apple-touch-icon" href="/img/<%- data.metadata.lang %>/launch/180.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/img/<%- data.metadata.lang %>/launch/180.png" />
  <link rel="apple-touch-icon" sizes="167x167" href="/img/<%- data.metadata.lang %>/launch/167.png" />
  <link rel="apple-touch-icon" sizes="152x152" href="/img/<%- data.metadata.lang %>/launch/152.png" />
  <link rel="manifest" href="/manifests/<%- data.metadata.lang %>.json" />
</head>

<body>
  <div class="master-container">
    <div class="container-fluid px-0">
      <div class="row">
        <div class="col-12 text-center">
          <div class="d-flex justify-content-between align-items-center bg-green">
            <a href="./dashboard" class="link-light text-decoration-none float-start px-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor"
                class="bi bi-house-fill" viewBox="0 0 16 16">
                <path
                  d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L8 2.207l6.646 6.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z">
                </path>
                <path d="m8 3.293 6 6V13.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5V9.293z"></path>
              </svg>
            </a>
            <h1 class="pageHeadline my-0 px-3 py-2 bg-green text-light d-inline-block">
              <%- data.appTitle %>
            </h1>
            <span class="float-end px-3">
              <button class="navbar-toggler link-light" type="button" data-bs-toggle="offcanvas"
                data-bs-target="#offcanvasWithBothOptions" aria-controls="offcanvasWithBothOptions">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-list"
                  viewBox="0 0 16 16">
                  <path fill-rule="evenodd"
                    d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
                </svg>
              </button>
            </span>
          </div>
          <div class="text-center px-2 py-2 bg-light-green text-light">
            <h2 class="pageHeadline my-0 balance"><%- data.pageTitle %></h2>
          </div>
        </div>
      </div>
    </div>

    <div class="offcanvas offcanvas-end" data-bs-scroll="true" tabindex="-1" id="offcanvasWithBothOptions"
      aria-labelledby="offcanvasWithBothOptionsLabel">
      <div class="offcanvas-header bg-green text-light py-1">
        <h5 class="offcanvas-title flex-grow-1" id="offcanvasWithBothOptionsLabel">
          <%- data.sideMenuHeader %>
        </h5>
        <button class="btn text-light" type="button" data-bs-dismiss="offcanvas" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-x-lg"
            viewBox="0 0 16 16">
            <path
              d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z" />
          </svg>
        </button>
      </div>
      <div class="offcanvas-body bg-light">
        <div class="list-group bg-white shadow">
          <a href="javascript:logOut()" class="list-group-item list-group-item-action">
            <%- globalData.logout %>
          </a>
        </div>
      </div>
    </div>

    <div class="container-fluid">
      <div class="row">
        <div class="col-12 col-md-8 offset-md-2 py-3">
          <% if(data.metadata.hasAudio) { %>
            <div class="audioContainer text-center my-3">
              <audio controls preload="none">
                <source src="/audio/<%- data.metadata.lang %>/persecution.webm" controls
                  type="audio/webm; codecs=opus" />
              </audio>
            </div>
            <% } %>

              <p class="text-center balance">
                <em><%- data.thisStudy %></em>
              </p>

              <p>
                <strong><%- data.introduction %></strong>
              </p>

              <ol>
                <li class="mb-3">
                  <div class="mb-3">
                    <strong><%- data.o1 %></strong>
                  </div>
                  <ol type="A">
                    <li class="mb-3">
                      <div class="mb-3">
                        <strong><%- data.o1a %></strong>
                      </div>
                      <ol>
                        <li class="mb-3"><%- data.o1a1 %></li>
                        <li class="mb-3"><%- data.o1a2 %></li>
                        <li class="mb-3"><%- data.o1a3 %></li>
                      </ol>
                    </li>
                    <li class="mb-3">
                      <div class="mb-3">
                        <strong><%- data.o1b %></strong>
                      </div>
                      <ol>
                        <li class="mb-3"><%- data.o1b1 %></li>
                        <li class="mb-3"><%- data.o1b2 %></li>
                      </ol>
                    </li>
                    <li class="mb-3">
                      <div class="mb-3">
                        <strong><%- data.o1c %></strong>
                      </div>
                      <ol>
                        <li class="mb-3"><%- data.o1c1 %></li>
                        <li class="mb-3"><%- data.o1c2 %></li>
                      </ol>
                    </li>
                  </ol>
                </li>
                <li class="mb-3">
                  <div class="mb-3">
                    <strong><%- data.o2 %></strong>
                  </div>
                  <ol type="A">
                    <li class="mb-3">
                      <div class="mb-3">
                        <strong><%- data.o2a %></strong>
                      </div>
                      <ol>
                        <li class="mb-3"><%- data.o2a1 %></li>
                        <li class="mb-3"><%- data.o2a2 %></li>
                        <li class="mb-3"><%- data.o2a3 %></li>
                        <li class="mb-3"><%- data.o2a4 %></li>
                      </ol>
                    </li>
                    <li class="mb-3">
                      <div class="mb-3">
                        <strong><%- data.o2b %></strong>
                      </div>
                      <ol>
                        <li class="mb-3"><%- data.o2b1 %></li>
                        <li class="mb-3"><%- data.o2b2 %></li>
                        <li class="mb-3"><%- data.o2b3 %></li>
                      </ol>
                    </li>
                  </ol>
                </li>
                <li class="mb-3">
                  <div class="mb-3">
                    <strong><%- data.o3 %></strong>
                  </div>
                  <ol type="A">
                    <li class="mb-3">
                      <div class="mb-3">
                        <strong><%- data.o3a %></strong>
                      </div>
                      <ol>
                        <li class="mb-3"><%- data.o3a1 %></li>
                        <li class="mb-3"><%- data.o3a2 %></li>
                      </ol>
                    </li>
                    <li class="mb-3">
                      <div class="mb-3">
                        <strong><%- data.o3b %></strong>
                      </div>
                      <ol>
                        <li class="mb-3">
                          <div class="mb-3"><%- data.o3b1 %></div>
                          <ol type="a">
                            <li class="mb-3"><%- data.o3b1a %></li>
                            <li class="mb-3"><%- data.o3b1b %></li>
                          </ol>
                        </li>
                        <li class="mb-3">
                          <div class="mb-3"><%- data.o3b2 %></div>
                          <ol type="a">
                            <li class="mb-3"><%- data.o3b2a %></li>
                            <li class="mb-3"><%- data.o3b2b %></li>
                            <li class="mb-3"><%- data.o3b2c %></li>
                            <li class="mb-3"><%- data.o3b2d %></li>
                          </ol>
                        </li>
                      </ol>
                    </li>
                    <li class="mb-3">
                      <div class="mb-3">
                        <strong><%- data.o3b3 %></strong>
                      </div>
                      <ol type="a">
                        <li class="mb-3"><%- data.o3b3a %></li>
                      </ol>
                    </li>
                  </ol>
                </li>
                <li class="mb-3">
                  <div class="mb-3">
                    <strong><%- data.o4 %></strong>
                  </div>
                  <ol type="A">
                    <li class="mb-3">
                      <div class="mb-3"><%- data.o4a %></div>
                      <ol>
                        <li class="mb-3"><%- data.o4a1 %></li>
                        <li class="mb-3"><%- data.o4a2 %></li>
                      </ol>
                    </li>
                    <li class="mb-3">
                      <div class="mb-3"><%- data.o4b %></div>
                      <ol>
                        <li class="mb-3"><%- data.o4b1 %></li>
                      </ol>
                    </li>
                  </ol>
                </li>
                <li class="mb-3"><%- data.o5 %></li>
              </ol>

              <div class="modal fade" id="modal" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalHeader"
                aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h1 class="modal-title fs-5" id="modalHeader"></h1>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body"></div>
                  </div>
                </div>
              </div>
        </div>
      </div>
    </div>

    <div class="container-fluid px-0">
      <div class="row">
        <div class="col-12">
          <footer class="mt-2 px-4 py-4 bg-dark text-light text-center">
            &copy; 1980-<%= new Date().getFullYear() %> Kip McKean
          </footer>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="content">
      <%- JSON.stringify(data) %>
    </script>
  <script type="application/json" id="globalContent">
      <%- JSON.stringify(globalData) %>
    </script>
  <script src="/js/global.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>

  <script src="/js/load-sw.js"></script>
</body>

</html>