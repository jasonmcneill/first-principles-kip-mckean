<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <meta name="view-transition" content="same-origin" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>Select Language - First Principles</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="master-container">
      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12 text-center">
            <header>
              <h1 class="my-0 px-4 py-2 bg-dark text-light">
                First Principles
              </h1>
              <h2 class="my-0 px-4 py-2 bg-secondary text-light">
                Select Language
              </h2>
            </header>
          </div>
        </div>
      </div>

      <div class="container-fluid">
        <div class="row">
          <div class="col-12 col-md-4 offset-md-4 px-3 py-3">
            <div class="list-group my-4 bg-white shadow">
              <a
                href="./en/dashboard"
                class="list-group-item list-group-item-action"
              >
                <%- languages["en"].name %>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12">
            <footer class="mt-2 px-4 py-4 bg-dark text-light text-center">
              &copy; 1980-<%= new Date().getFullYear() %> Kip McKean
            </footer>
          </div>
        </div>
      </div>
    </div>

    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker
            .register("/sw.js") // ← no type: "module"
            .then((reg) => console.log("SW registered:", reg))
            .catch((err) => console.error("SW registration failed:", err));
        });
      }

      // Listen for audio plays
      document.addEventListener(
        "play",
        (event) => {
          const el = event.target;
          if (el.tagName.toLowerCase() === "audio") {
            console.log("Audio playing:", el.currentSrc || el.src);
          }
        },
        true
      );
    </script>
  </body>
</html>
