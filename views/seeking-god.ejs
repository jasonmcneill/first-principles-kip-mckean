<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <meta name="view-transition" content="same-origin" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title><%- data.pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="master-container">
      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12 text-center bg-dark">
            <div class="d-flex justify-content-between align-items-center">
              <a
                href="./dashboard"
                class="link-light text-decoration-none float-start px-3"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  fill="currentColor"
                  class="bi bi-house-fill"
                  viewBox="0 0 16 16"
                >
                  <path
                    d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L8 2.207l6.646 6.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z"
                  />
                  <path
                    d="m8 3.293 6 6V13.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5V9.293z"
                  />
                </svg>
              </a>
              <h1 class="my-0 px-3 py-2 bg-dark text-light d-inline-block">
                <%- data.appTitle %>
              </h1>
              <span class="invisible float-end px-3">
                <div
                  class="d-inline-block"
                  style="width: 24px; height: 24px"
                ></div>
              </span>
            </div>
            <div class="text-center px-2 py-2 bg-secondary text-light">
              <h2 class="my-0 balance"><%- data.pageTitle %></h2>
            </div>
          </div>
        </div>
      </div>

      <div class="container-fluid">
        <div class="row">
          <div class="col-12 col-md-8 offset-md-2 px-3 py-3">
            <div class="audioContainer text-center my-3">
              <audio controls preload="none">
                <source
                  src="/audio/<%- data.metadata.lang %>/seeking-god.webm"
                  controls
                  type="audio/webm; codecs=opus"
                />
              </audio>
            </div>

            <ol>
              <li class="mb-3">
                <div>
                  <strong data-scripture="psalm-119-1-2"><%- data.o1 %></strong>
                </div>
                <ol type="A">
                  <li><%- data.o1a %></li>
                  <li><%- data.o1b %></li>
                  <li><%- data.o1c %></li>
                  <li><%- data.o1d %></li>
                </ol>
              </li>
              <li class="mb-3">
                <div>
                  <strong data-scripture="matthew-6-25-34">
                    <%- data.o2 %>
                  </strong>
                </div>
                <ol type="A">
                  <li><%- data.o2a %></li>
                  <li><%- data.o2b %></li>
                  <li><%- data.o2c %></li>
                  <li><%- data.o2d %></li>
                </ol>
              </li>
              <li class="mb-3">
                <div>
                  <strong data-scripture="acts-17-26-28">
                    <%- data.o3 %>
                  </strong>
                </div>
                <ol type="A">
                  <li><%- data.o3a %></li>
                  <li><%- data.o3b %></li>
                  <li><%- data.o3c %></li>
                  <li><%- data.o3d %></li>
                </ol>
              </li>
              <li class="mb-3">
                <div>
                  <strong data-scripture="john-4-23-24">
                    <%- data.o4 %>
                  </strong>
                </div>
                <ol type="A">
                  <li><%- data.o4a %></li>
                  <li><%- data.o4b %></li>
                </ol>
              </li>
              <li class="mb-3">
                <div>
                  <strong data-scripture="acts-17-10-12">
                    <%- data.o5 %>
                  </strong>
                </div>
                <ol type="A">
                  <li><%- data.o5a %></li>
                  <li><%- data.o5b %></li>
                </ol>
              </li>
              <li class="mb-3">
                <div>
                  <strong data-scripture="jeremiah-29-11-14">
                    <%- data.o6 %>
                  </strong>
                </div>
                <ol type="A">
                  <li><%- data.o6a %></li>
                  <li><%- data.o6b %></li>
                  <li><%- data.o6c %></li>
                </ol>
              </li>
              <li class="mb-3">
                <div>
                  <strong data-scripture="acts-8-26-39">
                    <%- data.o7 %>
                  </strong>
                </div>
                <ol type="A">
                  <li><%- data.o7a %></li>
                  <li><%- data.o7b %></li>
                  <li><%- data.o7c %></li>
                  <li><%- data.o7d %></li>
                </ol>
              </li>
              <li>
                <div>
                  <strong data-scripture="matthew-7-7-8">
                    <%- data.o8 %>
                  </strong>
                </div>
                <ol type="A">
                  <li><%- data.o8a %></li>
                  <li><%- data.o8b %></li>
                </ol>
              </li>
            </ol>

            <div
              class="modal fade"
              id="modal"
              data-bs-keyboard="false"
              tabindex="-1"
              aria-labelledby="modalHeader"
              aria-hidden="true"
            >
              <div
                class="modal-dialog modal-dialog-centered modal-dialog-scrollable"
              >
                <div class="modal-content">
                  <div class="modal-header">
                    <h1 class="modal-title fs-5" id="modalHeader">Test</h1>
                    <button
                      type="button"
                      class="btn-close"
                      data-bs-dismiss="modal"
                      aria-label="Close"
                    ></button>
                  </div>
                  <div class="modal-body"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12">
            <footer class="mt-2 px-4 py-4 bg-dark text-light text-center">
              &copy; 1980-<%= new Date().getFullYear() %> Kip McKean
            </footer>
          </div>
        </div>
      </div>
    </div>

    <script src="/js/global.js"></script>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>

    <script>
      // 1. Register the Service Worker
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", async () => {
          try {
            const reg = await navigator.serviceWorker.register("/sw.js", {
              type: "module", // 👈 key difference
            });
            console.log("Service Worker registered with scope:", reg.scope);
          } catch (err) {
            console.error("Service Worker registration failed:", err);
          }
        });
      }

      // 2. Listen for clicks on <audio> play buttons
      document.addEventListener(
        "play",
        (event) => {
          const el = event.target;
          if (el.tagName.toLowerCase() === "audio") {
            const src = el.currentSrc || el.src;
            console.log("Audio play triggered for:", src);

            // Optionally send a message to the SW
            if (navigator.serviceWorker.controller && src) {
              navigator.serviceWorker.controller.postMessage({
                type: "AUDIO_PLAY",
                url: src,
              });
            }
          }
        },
        true
      ); // use capture so it fires reliably
    </script>
  </body>
</html>
