<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%- data.pageTitle %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="master-container">
      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12 text-center">
            <header>
              <h1 class="my-0 px-4 py-2 bg-dark text-light">
                <%- data.appTitle %>
              </h1>
              <h2 class="my-0 px-4 py-2 bg-secondary text-light">
                <%- data.pageTitle %>
              </h2>
            </header>
          </div>
        </div>
      </div>

      <div class="container-fluid">
        <div class="row">
          <div class="col-12 col-md-8 offset-md-2 px-3 py-3">
            <ol>
              <li class="mb-3">
                <div><strong><%- data.o1 %></strong></div>
                <ol type="A">
                  <li><%- data.o1a %></li>
                  <li><%- data.o1b %></li>
                  <li><%- data.o1c %></li>
                  <li><%- data.o1d %></li>
                </ol>
              </li>
              <li class="mb-3">
                <div><strong><%- data.o2 %></strong></div>
                <ol type="A">
                  <li><%- data.o2a %></li>
                  <li><%- data.o2b %></li>
                  <li><%- data.o2c %></li>
                  <li><%- data.o2d %></li>
                </ol>
              </li>
              <li class="mb-3">
                <div><strong><%- data.o3 %></strong></div>
                <ol type="A">
                  <li><%- data.o3a %></li>
                  <li><%- data.o3b %></li>
                  <li><%- data.o3c %></li>
                  <li><%- data.o3d %></li>
                </ol>
              </li>
              <li class="mb-3">
                <div><strong><%- data.o4 %></strong></div>
                <ol type="A">
                  <li><%- data.o4a %></li>
                  <li><%- data.o4b %></li>
                </ol>
              </li>
              <li class="mb-3">
                <div><strong><%- data.o5 %></strong></div>
                <ol type="A">
                  <li><%- data.o5a %></li>
                  <li><%- data.o5b %></li>
                </ol>
              </li>
              <li class="mb-3">
                <div><strong><%- data.o6 %></strong></div>
                <ol type="A">
                  <li><%- data.o6a %></li>
                  <li><%- data.o6b %></li>
                  <li><%- data.o6c %></li>
                </ol>
              </li>
              <li class="mb-3">
                <div><strong><%- data.o7 %></strong></div>
                <ol type="A">
                  <li><%- data.o7a %></li>
                  <li><%- data.o7b %></li>
                  <li><%- data.o7c %></li>
                  <li><%- data.o7d %></li>
                </ol>
              </li>
              <li>
                <div><strong><%- data.o8 %></strong></div>
                <ol type="A">
                  <li><%- data.o8a %></li>
                  <li><%- data.o8b %></li>
                </ol>
              </li>
            </ol>
          </div>
        </div>
      </div>

      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12">
            <footer class="mt-2 px-4 py-4 bg-dark text-light text-center">
              &copy; 1980-<%= new Date().getFullYear() %> <%-
              data.copyrightOwner %>
            </footer>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
