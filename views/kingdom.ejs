<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%- data.pageTitle %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <div class="master-container">
      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12 text-center">
            <header>
              <h1 class="my-0 px-4 py-2 bg-dark text-light">
                <a href="./dashboard" class="link-light text-decoration-none">
                  <%- data.appTitle %>
                </a>
              </h1>
              <h2 class="my-0 px-4 py-2 bg-secondary text-light">
                <%- data.pageTitle %>
              </h2>
            </header>
          </div>
        </div>
      </div>

      <div class="container-fluid">
        <div class="row">
          <div class="col-12 col-md-8 offset-md-2 px-3 py-3">
            <p>
              <strong><%- data.p1 %></strong>
            </p>

            <p>
              <strong><%- data.p2 %></strong>
            </p>

            <ol>
              <li class="mb-3">
                <div class="mb-3">
                  <strong><%- data.o1Bold %></strong>
                  <%- data.o1NotBold %>
                </div>
                <ol type="A">
                  <li class="mb-3">
                    <div class="mb-3">
                      <strong><%- data.o1aScripture %></strong>
                      <%- data.o1aDate %>
                    </div>
                    <ol>
                      <li class="mb-3"><%- data.o1a1 %></li>
                      <li class="mb-3"><%- data.o1a2 %></li>
                      <li class="mb-3"><%- data.o1a3 %></li>
                      <li class="mb-3"><%- data.o1a4 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3">
                      <strong><%- data.o1bScripture %></strong>
                      <%- data.o1bDate %>
                    </div>
                    <ol>
                      <li class="mb-3"><%- data.o1b1 %></li>
                      <li class="mb-3"><%- data.o1b2 %></li>
                      <li class="mb-3"><%- data.o1b3 %></li>
                      <li class="mb-3"><%- data.o1b4 %></li>
                      <li class="mb-3"><%- data.o1b5 %></li>
                      <li class="mb-3"><%- data.o1b6 %></li>
                    </ol>
                  </li>
                  <li class="mb-3"><%- data.o1c %></li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o1d %></div>
                    <ol>
                      <li class="mb-3"><%- data.o1d1 %></li>
                      <li class="mb-3"><%- data.o1d2 %></li>
                    </ol>
                  </li>
                </ol>
              </li>
              <li class="mb-3">
                <div class="mb-3">
                  <strong><%- data.o2Bold %></strong>
                  <%- data.o2NotBold %>
                </div>
                <ol>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o2a %></div>
                    <ol>
                      <li class="mb-3"><%- data.o2a1 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o2b %></div>
                    <ol>
                      <li class="mb-3"><%- data.o2b1 %></li>
                      <li class="mb-3"><%- data.o2b2 %></li>
                      <li class="mb-3"><%- data.o2b3 %></li>
                      <li class="mb-3"><%- data.o2b4 %></li>
                      <li class="mb-3"><%- data.o2b5 %></li>
                      <li class="mb-3"><%- data.o2b6 %></li>
                      <li class="mb-3"><%- data.o2b7 %></li>
                      <li class="mb-3"><%- data.o2b8 %></li>
                    </ol>
                  </li>
                </ol>
              </li>
              <li class="mb-3">
                <div class="mb-3">
                  <strong><%- data.o3 %></strong>
                </div>
                <ol>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o3a %></div>
                    <ol>
                      <li class="mb-3"><%- data.o3a1 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o3b %></div>
                    <ol>
                      <li class="mb-3"><%- data.o3b1 %></li>
                      <li class="mb-3"><%- data.o3b2 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o3c %></div>
                    <ol>
                      <li class="mb-3"><%- data.o3c1 %></li>
                      <li class="mb-3"><%- data.o3c2 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o3d %></div>
                    <ol>
                      <li class="mb-3"><%- data.o3d1 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o3e %></div>
                    <ol>
                      <li class="mb-3"><%- data.o3e1 %></li>
                      <li class="mb-3"><%- data.o3e2 %></li>
                      <li class="mb-3"><%- data.o3e3 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o3f %></div>
                    <ol>
                      <li class="mb-3"><%- data.o3f1 %></li>
                      <li class="mb-3"><%- data.o3f2 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o3g %></div>
                    <ol>
                      <li class="mb-3"><%- data.o3g1 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o3h %></div>
                    <ol>
                      <li class="mb-3"><%- data.o3h1 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o3i %></div>
                    <ol>
                      <li class="mb-3"><%- data.o3i1 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o3j %></div>
                    <ol>
                      <li class="mb-3"><%- data.o3j1 %></li>
                    </ol>
                  </li>
                  <li class="mb-3">
                    <div class="mb-3"><%- data.o3k %></div>
                    <ol>
                      <li class="mb-3"><%- data.o3k1 %></li>
                    </ol>
                  </li>
                </ol>
              </li>
              <li class="mb-3">
                <div class="mb-3">
                  <strong><%- data.o4 %></strong>
                </div>
                <ol>
                  <li class="mb-3"><%- data.o4a %></li>
                  <li class="mb-3">
                    <strong><%- data.o4bScripture %></strong>
                    <%- data.o4bText %>
                  </li>
                  <li class="mb-3">
                    <strong><%- data.o4cScripture %></strong>
                    <%- data.o4cText %>
                  </li>
                </ol>
              </li>
            </ol>
          </div>
        </div>
      </div>

      <div class="container-fluid px-0">
        <div class="row">
          <div class="col-12">
            <footer class="mt-2 px-4 py-4 bg-dark text-light text-center">
              &copy; 1980-<%= new Date().getFullYear() %> Kip McKean
            </footer>
          </div>
        </div>
      </div>
    </div>

    <script>
      if (window.location.hostname !== "localhost") {
        if ("serviceWorker" in navigator) {
          window.addEventListener("load", () => {
            navigator.serviceWorker
              .register("/service-worker.js")
              .then((registration) => {
                console.log(
                  "Service Worker registered with scope:",
                  registration.scope
                );
              })
              .catch((err) => {
                console.log("Service Worker registration failed:", err);
              });
          });
        }
      }
    </script>
  </body>
</html>
